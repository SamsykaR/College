####### Compile

about.o: ../../about.cpp ../../about.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o about.o ../../about.cpp

global.o: ../../global.cpp ../../global.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o global.o ../../global.cpp

listing.o: ../../listing.cpp ../../listing.h \
		../../redact.h \
		../../global.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o listing.o ../../listing.cpp

login.o: ../../login.cpp ../../login.h \
		../../global.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o login.o ../../login.cpp

main.o: ../../main.cpp ../../widget.h \
		../../login.h \
		../../regist.h \
		../../global.h \
		../../about.h \
		../../listing.h \
		../../redact.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

redact.o: ../../redact.cpp ../../redact.h \
		../../global.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o redact.o ../../redact.cpp

regist.o: ../../regist.cpp ../../regist.h \
		../../global.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o regist.o ../../regist.cpp

widget.o: ../../widget.cpp ../../widget.h \
		../../login.h \
		../../regist.h \
		../../global.h \
		../../about.h \
		../../listing.h \
		../../redact.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o widget.o ../../widget.cpp

moc_about.o: moc_about.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_about.o moc_about.cpp

moc_listing.o: moc_listing.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_listing.o moc_listing.cpp

moc_login.o: moc_login.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_login.o moc_login.cpp

moc_redact.o: moc_redact.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_redact.o moc_redact.cpp

moc_regist.o: moc_regist.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_regist.o moc_regist.cpp

moc_widget.o: moc_widget.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_widget.o moc_widget.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/SamsykaPrctice/bin || mkdir -p $(INSTALL_ROOT)/opt/SamsykaPrctice/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/SamsykaPrctice/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/SamsykaPrctice/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/SamsykaPrctice/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

