####### Compile

main.o: ../Formula/main.cpp ../Formula/widget.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../Formula/main.cpp

widget.o: ../Formula/widget.cpp ../Formula/widget.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o widget.o ../Formula/widget.cpp

moc_widget.o: moc_widget.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_widget.o moc_widget.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Formula/bin || mkdir -p $(INSTALL_ROOT)/opt/Formula/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/Formula/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/Formula/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/Formula/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Formula/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

