	-$(DEL_FILE) moc_widget.cpp
moc_widget.cpp: ../Formula/widget.h \
		moc_predefs.h \
		/usr/lib64/qt6/libexec/moc
	/usr/lib64/qt6/libexec/moc $(DEFINES) --include /home/user/Документы/Samsyka/mobile/LR4/build-Formula-Desctop-Release/moc_predefs.h -I/usr/lib64/qt6/mkspecs/linux-clang -I/home/user/Документы/Samsyka/mobile/LR4/Formula -I/usr/include/qt6 -I/usr/include/qt6/QtWidgets -I/usr/include/qt6/QtGui -I/usr/include/qt6/QtCore -I. -I/usr/include/c++/10 -I/usr/include/c++/10/x86_64-alt-linux -I/usr/include/c++/10/backward -I/usr/local/include -I/usr/lib/llvm-11.0/lib64/clang/11.0.1/include -I/usr/include ../Formula/widget.h -o moc_widget.cpp

